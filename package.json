{
  "name": "rack-and-roll",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "cap:sync": "npm run build && cap sync",
    "ios": "npm run build && cap sync ios && cap open ios",
    "android": "npm run build && cap sync android && cap open android",
    "assets": "bash scripts/build-assets.sh"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.0",
    "@capgo/native-purchases": "^8.9.6",
    "@fontsource/saira": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "three": "^0.159.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@gltf-transform/cli": "^4.5.1",
    "@types/three": "^0.159.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
