    "@capacitor/status-bar": "^8.0.0",
    "three": "^0.159.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/three": "^0.159.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
